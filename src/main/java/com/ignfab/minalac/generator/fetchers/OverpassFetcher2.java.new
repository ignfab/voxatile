package com.ignfab.minalac.generator.fetchers;

import java.util.LinkedList;

import com.ignfab.minalac.generator.exceptions.GenerationFailedException;
import com.ignfab.minalac.generator.exceptions.RetryableException;
import com.ignfab.minalac.generator.utils.network.ParameterizedURL;
import com.ignfab.minalac.generator.utils.world3d.WorldBBox3d;

public class OverpassFetcher2 extends HttpFetcher {

    protected OverpassFetcher2(HttpInit init, ParameterizedURL baseURL) {
        super(init, baseURL);
        //TODO Auto-generated constructor stub
    }

    @Override
    public FetchResult fetch(WorldBBox3d bbox) throws RetryableException, GenerationFailedException {
        // TODO Auto-generated method stub
        throw new UnsupportedOperationException("Unimplemented method 'fetch'");
    }


    /// On passe par des chaines, de toutes façons, pour pouvoir paralléliser le traitement des données en aval, il faut tout lire et splitter.

    public static List<String> splitOverpassResults(String input) {
        List<String> result = new LinkedList<>();

        Pattern pattern = Pattern.compile("(.*?)(<(node|way|relation).*)", Pattern.DOTALL);
        Matcher matcher = pattern.matcher(input);

        if (!matcher.find())
            throw new IllegalArgumentException("Bad format");

        String prefix = matcher.group(1);
        String remains = matcher.group(2);
        String suffix = "</osm>";

        pattern = Pattern.compile("(.*?)(<separator .*?/>|</osm>)", Pattern.DOTALL);
        matcher = pattern.matcher(remains);
        while(matcher.find()) {
            result.add(prefix + matcher.group(1) + suffix);
        }

        return result;
    }

}
